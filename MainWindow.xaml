<Window x:Class="Dobokocka.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Dobokocka"
        xmlns:viewmodels="clr-namespace:Dobokocka.ViewModels"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.DataContext>
        <viewmodels:MainViewModel/>
    </Window.DataContext>
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <Label HorizontalAlignment="Center" FontSize="24" FontWeight="Bold">Kockadobás</Label>

        <Label>Kockák száma:</Label>
        <Slider Minimum="2" Maximum="10" Value="{Binding NumberOfDice}" TickFrequency="1" IsSnapToTickEnabled="True" IsEnabled="{Binding InputEnabled}"/>
        <Label Content="{Binding NumberOfDice}"/>

        <ItemsControl ItemsSource="{Binding DiceDisplay}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style>
                    <Setter Property="FrameworkElement.Margin" Value="5"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
        </ItemsControl>

        <Button Command="{Binding RollCommand}">Dobás</Button>
    </StackPanel>
</Window>
