<Window x:Class="Dobokocka.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Dobokocka"
        xmlns:viewmodels="clr-namespace:Dobokocka.ViewModels"
        xmlns:helpers="clr-namespace:Dobokocka.Helpers"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        MinHeight="300" MinWidth="650">
    <Window.DataContext>
        <viewmodels:MainViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <helpers:IntArrayToStringConverter x:Key="IntArrayToStringConverter"/>
    </Window.Resources>
    <DockPanel>
        <!-- Bet panel -->
        <StackPanel DockPanel.Dock="Left" Background="LightGray" Width="175">
            <TextBlock Margin="10" Text="{Binding Balance, StringFormat='{}Egyenleg: {0:c0}', ConverterCulture='hu-HU' }" TextAlignment="Center" FontSize="14"/>
            <Border BorderThickness="0.5" BorderBrush="Gray" Margin="5 0"/>
            <StackPanel Margin="10" Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock>Tét:</TextBlock>
                <TextBox Width="50" Margin="5 0 0 0" TextAlignment="Right" Text="{Binding Bet, NotifyOnSourceUpdated=True}"></TextBox>
                <TextBlock>Ft</TextBlock>
            </StackPanel>
        </StackPanel>
        
        <!-- Past rolls panel -->
        <ScrollViewer DockPanel.Dock="Right" Background="LightGray" VerticalScrollBarVisibility="Auto" Width="175">
            <StackPanel>
                <TextBlock Margin="10" FontWeight="Bold" TextAlignment="Center" FontSize="14">Dobási előzmények</TextBlock>
                <ItemsControl ItemsSource="{Binding Rolls}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0 5" Background="DarkGray">
                                <TextBlock Margin="10 10 10 2" Text="{Binding DiceValues, StringFormat='{}Dobások: {0}', Converter={StaticResource IntArrayToStringConverter}}" TextWrapping="Wrap"/>
                                <TextBlock Margin="10 2 10 2" Text="{Binding Bet, StringFormat='{}Tét: {0:c0}', ConverterCulture='hu-HU'}"/>
                                <TextBlock Margin="10 2 10 10" Text="{Binding Multiplier, StringFormat='{}Nyerési szorzó: {0}x'}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Margin="10 0"></StackPanel>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Button Command="{Binding RollCommand}" DockPanel.Dock="Bottom" Margin="20" MaxWidth="300" >Dobás</Button>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30">
                <Label HorizontalAlignment="Center" FontSize="24" FontWeight="Bold">Kockadobás</Label>

                <Label MaxWidth="300">Kockák száma:</Label>
                <Grid MaxWidth="300">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="0" Minimum="2" Maximum="10" Value="{Binding NumberOfDice}" TickFrequency="1" IsSnapToTickEnabled="True" IsEnabled="{Binding InputEnabled}" VerticalAlignment="Center"/>
                    <Label Grid.Column="1" Content="{Binding NumberOfDice}" VerticalAlignment="Center"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding DiceDisplay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style>
                            <Setter Property="FrameworkElement.Margin" Value="5"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
