<Window x:Class="Dobokocka.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Dobokocka"
        xmlns:viewmodels="clr-namespace:Dobokocka.ViewModels"
        xmlns:helpers="clr-namespace:Dobokocka.Helpers"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.DataContext>
        <viewmodels:MainViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <helpers:IntArrayToStringConverter x:Key="IntArrayToStringConverter"/>
    </Window.Resources>
    <DockPanel>
        <!-- Bet panel -->
        <StackPanel DockPanel.Dock="Left" Background="LightGray">
            <TextBlock Margin="10" Text="{Binding Balance, StringFormat='{}Egyenleg: {0:c0}', ConverterCulture='hu-HU' }"/>
            <Border BorderThickness="0.5" BorderBrush="Gray" Margin="5 0"/>
            <StackPanel Margin="10" Orientation="Horizontal">
                <TextBlock>Tét:</TextBlock>
                <TextBox Width="75" Margin="5 0 0 0" TextAlignment="Right" Text="{Binding Bet, NotifyOnSourceUpdated=True}"></TextBox>
                <TextBlock>Ft</TextBlock>
            </StackPanel>
        </StackPanel>
        
        <!-- Past rolls panel -->
        <ScrollViewer DockPanel.Dock="Right" Background="LightGray" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Margin="10">Dobási előzmények</TextBlock>
                <ItemsControl ItemsSource="{Binding Rolls}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0 5" Background="LightSlateGray">
                                <TextBlock Margin="5 5 0 5" Text="{Binding DiceValues, StringFormat='{}Dobások: {0}', Converter={StaticResource IntArrayToStringConverter}}"/>
                                <TextBlock Margin="5 0 0 5" Text="{Binding Bet, StringFormat='{}Tét: {0:c0}', ConverterCulture='hu-HU'}"/>
                                <TextBlock Margin="5 0 5 5" Text="{Binding Multiplier, StringFormat='{}Nyerési szorzó: {0}x'}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Margin="10 0"></StackPanel>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Label HorizontalAlignment="Center" FontSize="24" FontWeight="Bold">Kockadobás</Label>

            <Label>Kockák száma:</Label>
            <Slider Minimum="2" Maximum="10" Value="{Binding NumberOfDice}" TickFrequency="1" IsSnapToTickEnabled="True" IsEnabled="{Binding InputEnabled}"/>
            <Label Content="{Binding NumberOfDice}"/>

            <ItemsControl ItemsSource="{Binding DiceDisplay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style>
                        <Setter Property="FrameworkElement.Margin" Value="5"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>

            <Button Command="{Binding RollCommand}">Dobás</Button>
        </StackPanel>
    </DockPanel>
</Window>
